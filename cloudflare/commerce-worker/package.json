{
  "name": "systemb-commerce",
  "private": true,
  "type": "module",
  "scripts": {
    "build:assets": "node scripts/build-assets.mjs",
    "dev": "node scripts/build-assets.mjs && wrangler dev --config wrangler.toml",
    "dry-run": "node scripts/build-assets.mjs && wrangler deploy --dry-run --outdir dist/bundle --config wrangler.toml",
    "smoke": "node scripts/build-assets.mjs && node scripts/local-smoke.mjs"
  },
  "devDependencies": {
    "wrangler": "4.147.0"
  }
}
