+
+    async function getV5AdminReadiness(slug) {
+      const response = await fetch('/api/v5-readiness?course=' + encodeURIComponent(slug), {
+        cache: 'no-store',
+        headers: { 'X-Admin-Password': currentAdminPassword }
+      });
+      const data = await response.json().catch(() => ({}));
+      if (!response.ok) throw new Error(data.error || 'Không kiểm tra được trạng thái LMS V5');
+      return data;
+    }
+
+    async function hydrateV5Readiness(courses) {
+      const v5Courses = (Array.isArray(courses) ? courses : []).filter(course => course.deliveryMode === 'v5');
+      await Promise.all(v5Courses.map(async course => {
+        const badge = document.getElementById('v5-state-' + course.id);
+        const content = document.getElementById('v5-content-' + course.id);
+        try {
+          const data = await getV5AdminReadiness(course.slug);
+          if (badge) {
+            badge.className = 'inline-flex px-2.5 py-1 rounded-lg text-[10px] font-black ' + (data.canonicalReady ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700');
+            badge.innerText = data.canonicalReady ? 'V5: Published' + (data.release?.version ? ' · r' + data.release.version : '') : 'V5: Draft / chưa sẵn sàng';
+          }
+          if (content) {
+            content.className = 'text-sm font-black ' + (data.canonicalReady ? 'text-emerald-700' : 'text-amber-700');
+            content.innerText = data.canonicalReady
+              ? '🟢 Published' + (data.release?.version ? ' · Release ' + data.release.version : '')
+              : '🟠 Draft / chưa có Published release hợp lệ';
+          }
+        } catch (error) {
+          if (badge) {
+            badge.className = 'inline-flex px-2.5 py-1 rounded-lg text-[10px] font-black bg-rose-100 text-rose-700';
+            badge.innerText = 'V5: không kiểm tra được';
+          }
+          if (content) {
+            content.className = 'text-sm font-black text-rose-700';
+            content.innerText = 'Không kiểm tra được canonical V5';
+          }
+        }
+      }));
+    }
+
+    async function openV5Channel(slug) {
+      const courseSlug = String(slug || '').trim();
+      if (!courseSlug) return showToast('Hãy lưu khóa V5 trước.');
+      try {
+        const response = await fetch('/api/config?runtime=1', { cache: 'no-store' });
+        const runtime = await response.json().catch(() => ({}));
+        if (!response.ok) throw new Error(runtime.error || 'Không tải được cấu hình LMS V5');
+        const base = String(runtime.v4PublicUrl || window.location.origin).replace(/\/$/, '');
+        window.open(base + '/v5-admin.html?course=' + encodeURIComponent(courseSlug), '_blank', 'noopener');
+      } catch (error) {
+        alert(error.message || 'Không mở được V5 Channel');
+      }
+    }
+
+    function openV5ChannelFromModal() {
+      openV5Channel(document.getElementById('courseSlugInput')?.value || '');
+    }
+
+    async function refreshV5ModalState(slug) {
+      const node = document.getElementById('v5ModalContentState');
+      if (!node) return;
+      const courseSlug = String(slug || '').trim();
+      if (!courseSlug || !document.getElementById('courseId')?.value) {
+        node.innerText = 'Lưu khóa trước để mở V5 Channel.';
+        return;
+      }
+      node.innerText = 'Đang kiểm tra trạng thái canonical V5...';
+      try {
+        const data = await getV5AdminReadiness(courseSlug);
+        node.innerText = data.canonicalReady
+          ? '✓ Published' + (data.release?.version ? ' · Release ' + data.release.version : '') + (data.canSell ? ' · Đang bán' : ' · Có thể bật bán tại Commerce')
+          : 'Draft / chưa có Published release hợp lệ';
+      } catch (error) {
+        node.innerText = error.message || 'Không kiểm tra được trạng thái V5';
+      }
+    }
