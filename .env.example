# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin Authentication
ADMIN_PASSWORD=your-secure-admin-password

# Cloudinary Configuration (For payment proof receipt uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Telegram course delivery
# Bot must be an admin in each private course group/channel and able to manage invite/join requests.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-secret
TELEGRAM_ADMIN_CHAT_ID=your-admin-chat-id
# Comma-separated Telegram numeric user IDs allowed to press approve/decline buttons.
TELEGRAM_ADMIN_USER_IDS=123456789
