# Clone identity and public origins (non-secret)
SYSTEM_ID=system-b
SYSTEM_NAME=YeuBep
COMMERCE_PUBLIC_URL=https://yeubep.shop
LMS_PUBLIC_URL=https://hoc.yeubep.shop
V4_PUBLIC_URL=https://v4.daubepnho.store
# Optional dedicated V5 server-to-server origin. If unset, V5 sync uses V4_PUBLIC_URL
# because V4/V5 currently share the canonical LMS runtime project.
# V5_LMS_PUBLIC_URL=https://v5.daubepnho.store
TELEGRAM_CLONER_URL=https://reader.yeubep.shop
LEGACY_PORTAL_PUBLIC_URL=https://yeunauan.live

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin Authentication
ADMIN_PASSWORD=your-secure-admin-password

# Internal Hệ thống B orchestration (same value on Commerce, LMS and Cloner)
INTERNAL_SYNC_SECRET=generate-a-long-random-clone-only-secret
# Optional during V5 Preview E2E: point only Commerce Preview at the LMS V5 Preview origin.
# Production ignores this Preview override.
# V5_LMS_SYNC_URL=https://your-lms-v5-preview.vercel.app
# Legacy aliases remain supported for existing deployments:
# SYSTEM3_URL=https://hoc.yeubep.shop
# SYSTEM1_URL=https://yeunauan.live

# Cloudinary Configuration (For payment proof receipt uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Telegram course delivery
# Bot must be an admin in each private course group/channel and able to manage invite/join requests.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-secret
TELEGRAM_ADMIN_CHAT_ID=your-admin-chat-id
# Comma-separated Telegram numeric user IDs allowed to press approve/decline buttons.
TELEGRAM_ADMIN_USER_IDS=123456789
